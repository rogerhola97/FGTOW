# Copia este archivo como .env.local para trabajar en tu computadora.
# En Cloudflare, crea estas mismas variables como secretos del Worker.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZA_ESTA_CLAVE

# Envío automático del cotizador 2D. La llave debe guardarse como secreto.
RESEND_API_KEY=re_REEMPLAZA_ESTA_CLAVE
QUOTE_TO_EMAIL=contacto@fgtow.com
QUOTE_FROM_EMAIL=FG TOW Cotizaciones <cotizaciones@fgtow.com>

# Captcha (Cloudflare Turnstile) para /cotizador/*. TURNSTILE_SITE_KEY es pública (se manda al
# navegador); TURNSTILE_SECRET_KEY debe guardarse como secreto. Si se dejan sin configurar, el
# formulario público sigue funcionando pero sin protección anti-bot.
TURNSTILE_SITE_KEY=0x0000000000000000000000AA
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000AA
